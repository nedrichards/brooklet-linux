using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: _("General");

    Adw.ShortcutsItem {
      title: _("Sync articles");
      action-name: "app.sync";
      accelerator: "<Control>r";
    }

    Adw.ShortcutsItem {
      title: _("Search Library");
      action-name: "app.search";
      accelerator: "<Control>f";
    }

    Adw.ShortcutsItem {
      title: _("Undo Mark Read");
      action-name: "win.undo";
      accelerator: "<Control>z";
    }

    Adw.ShortcutsItem {
      title: _("Show keyboard shortcuts");
      action-name: "app.show-shortcuts";
      accelerator: "F1";
      subtitle: _("Anywhere in Brooklet");
    }

    Adw.ShortcutsItem {
      title: _("Show keyboard shortcuts");
      action-name: "app.show-shortcuts";
      accelerator: "<Control>question";
      subtitle: _("Anywhere in Brooklet");
    }

    Adw.ShortcutsItem {
      title: _("Quit Brooklet");
      action-name: "app.quit";
      accelerator: "<Control>q";
    }
  }

  Adw.ShortcutsSection {
    title: _("Article lists");

    Adw.ShortcutsItem {
      title: _("Dismiss or restore selected article");
      accelerator: "r";
      subtitle: _("In a list; does not open the article");
    }

    Adw.ShortcutsItem {
      title: _("Move to next article");
      accelerator: "j";
      subtitle: _("At startup or with an article list focused");
    }

    Adw.ShortcutsItem {
      title: _("Move to next article");
      accelerator: "Down";
      subtitle: _("At startup or with an article list focused");
    }

    Adw.ShortcutsItem {
      title: _("Move to previous article");
      accelerator: "k";
      subtitle: _("At startup or with an article list focused");
    }

    Adw.ShortcutsItem {
      title: _("Move to previous article");
      accelerator: "Up";
      subtitle: _("At startup or with an article list focused");
    }

    Adw.ShortcutsItem {
      title: _("Open selected article");
      accelerator: "Return";
      subtitle: _("Selection alone does not mark it read");
    }
  }

  Adw.ShortcutsSection {
    title: _("Reader");

    Adw.ShortcutsItem {
      title: _("Toggle open article read or unread");
      accelerator: "r";
      subtitle: _("Marking unread returns to the source list");
    }

    Adw.ShortcutsItem {
      title: _("Scroll article down");
      accelerator: "j";
      subtitle: _("When the reader has focus");
    }

    Adw.ShortcutsItem {
      title: _("Scroll article up");
      accelerator: "k";
      subtitle: _("When the reader has focus");
    }
  }

  Adw.ShortcutsSection {
    title: _("Navigation");

    Adw.ShortcutsItem {
      title: _("Keep current article unread");
      action-name: "win.keep-unread";
      accelerator: "u";
      subtitle: _("While reading, outside text fields");
    }

    Adw.ShortcutsItem {
      title: _("Go back");
      action-name: "win.back";
      accelerator: "<Alt>Left";
      subtitle: _("Dismiss a dialog or return to the previous view");
    }

    Adw.ShortcutsItem {
      title: _("Dismiss a dialog or go back");
      action-name: "win.back";
      accelerator: "Escape";
      subtitle: _("From the reader, return focus to the article list");
    }
  }
}
